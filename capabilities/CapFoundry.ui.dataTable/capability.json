{
  "schemaVersion": 1,
  "name": "CapFoundry.ui.dataTable",
  "version": "1.1.0",
  "description": "Generate a framework-free, accessible sortable table as an HTML Custom Element, with an openable preview",
  "aliases": [
    "sortable table component",
    "html custom element table",
    "web component grid",
    "vanilla js table widget",
    "accessible data table markup",
    "build a table without a framework"
  ],
  "exampleQueries": [
    "generate a sortable table web component for these columns",
    "i need an accessible html table widget without react",
    "create a custom element that renders rows with column sorting",
    "vanilla javascript data table with keyboard accessible sorting",
    "build a framework free table component from a column spec",
    "render a sortable table i can open in a browser from these rows"
  ],
  "tags": [
    "ui",
    "html",
    "component",
    "web-component",
    "table",
    "accessibility"
  ],
  "inputSummary": "A column spec, optional sample rows, plus caption, empty text and element name",
  "outputSummary": "Custom Element source, a usage snippet with your rows, and a standalone HTML preview",
  "runtime": "deno",
  "effect": "PURE",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "columns"
    ],
    "properties": {
      "columns": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "string",
                "number",
                "date"
              ]
            },
            "align": {
              "enum": [
                "start",
                "end",
                "center"
              ]
            },
            "sortable": {
              "type": "boolean"
            }
          }
        }
      },
      "sortable": {
        "type": "boolean"
      },
      "caption": {
        "type": "string",
        "maxLength": 300
      },
      "emptyText": {
        "type": "string",
        "maxLength": 300
      },
      "elementName": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "rows": {
        "type": "array",
        "maxItems": 100,
        "description": "Sample rows keyed by column key. Used for the usage example and the preview; never baked into the component.",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "elementName",
      "javascript",
      "usageExample",
      "preview",
      "columnCount",
      "rowCount"
    ],
    "properties": {
      "elementName": {
        "type": "string"
      },
      "javascript": {
        "type": "string"
      },
      "usageExample": {
        "type": "string"
      },
      "columnCount": {
        "type": "integer",
        "minimum": 1
      },
      "preview": {
        "type": "string"
      },
      "rowCount": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "artifact": {
    "type": "typescript",
    "entrypoint": "./artifact/index.ts",
    "sha256": "d2728ba416b70b34c0e21226a2b47750a8a45325933835e42c527da50acdd55a"
  },
  "exposure": {
    "execution": true,
    "artifact": true
  },
  "tests": "./tests/"
}
