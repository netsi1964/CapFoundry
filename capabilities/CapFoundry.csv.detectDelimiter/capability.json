{
  "schemaVersion": 1,
  "name": "CapFoundry.csv.detectDelimiter",
  "version": "1.0.0",
  "description": "Infer which character separates fields in CSV-like text, with supporting evidence",
  "aliases": [
    "guess the separator",
    "comma or semicolon",
    "sniff a spreadsheet export",
    "figure out the field separator",
    "tab or pipe separated",
    "parse an unknown flat file"
  ],
  "exampleQueries": [
    "work out whether this file is comma or semicolon separated",
    "detect the field separator in an unknown spreadsheet export",
    "is this data tab delimited or pipe delimited",
    "sniff the delimiter before parsing a flat file",
    "guess how these columns are separated"
  ],
  "tags": [
    "csv",
    "parsing",
    "data",
    "import",
    "inference"
  ],
  "inputSummary": "CSV-like text plus optional candidate characters and a row limit",
  "outputSummary": "The likely delimiter, a confidence, the field count and per-candidate evidence",
  "runtime": "deno",
  "effect": "PURE",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string"
      },
      "candidates": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        }
      },
      "maxRows": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "delimiter",
      "confidence",
      "fieldCount",
      "evidence",
      "reason"
