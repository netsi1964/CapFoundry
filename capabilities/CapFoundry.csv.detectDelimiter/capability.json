          ],
          "properties": {
            "delimiter": {
              "type": "string"
            },
            "modalFieldCount": {
              "type": "integer"
            },
            "consistency": {
              "type": "number"
            },
            "averagePerRow": {
              "type": "number"
            },
            "rowsExamined": {
              "type": "integer"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
