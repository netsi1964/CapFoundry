    "properties": {
      "delimiter": {
        "type": [
          "string",
          "null"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "fieldCount": {
        "type": [
          "integer",
          "null"
        ]
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delimiter",
            "modalFieldCount",
